# ChainCircle backend env vars
# Copy to .env and fill in. Never commit .env.

# Deployer wallet — needed for hardhat deploy/verify tasks
PRIVATE_KEY=your_private_key_here

# Push Chain testnet (pushDonut / chainId 42101)
# Falls back to these defaults in hardhat.config.js if unset
PUSH_CHAIN_RPC=https://evm.donut.rpc.push.org/
PUSH_CHAIN_ID=42101
PUSH_CHAIN_EXPLORER=https://donut.push.network